<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Registry;
use Fisharebest\Webtrees\Services\ModuleService;
use MyTree\Identity\IdentityModule;

/**
 * Replaces the core view "layouts/administration" (registered in
 * IdentityModule::boot()): the core control-panel layout, unchanged except
 * for the MyTree favicon and title.
 *
 * All data passed to this view is forwarded to the core view as-is.
 */

$core_data = get_defined_vars();

$identity = Registry::container()->get(ModuleService::class)->findByInterface(IdentityModule::class)->first();
$html     = view('::layouts/administration', $core_data);

?>
<?= $identity instanceof IdentityModule ? $identity->rewriteAdministrationLayout($html) : $html ?>
